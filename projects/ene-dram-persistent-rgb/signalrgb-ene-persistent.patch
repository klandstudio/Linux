+	SaveStaticColorPersistent(hexColor) {
+		if (this.config.XTREEM) {
+			device.log("Persistent save test is disabled for XTREEM RAM.");
+			return;
+		}
+
+		if (this.config.deviceProtocolVersion !== "V1" && this.config.deviceProtocolVersion !== "V2") {
+			device.log(
+				`Persistent save aborted: unsupported/unknown ENE protocol ${this.config.deviceProtocolVersion}`
+			);
+			return;
+		}
+
+		const Color = hexToRgb(hexColor);
+		const RGBData = [];
+
+		// ENE/OpenRGB byte order is R, B, G.
+		for (let i = 0; i < this.config.deviceLEDCount; i++) {
+			RGBData.push(Color[0], Color[2], Color[1]);
+		}
+
+		const effectStart =
+			this.config.deviceProtocolVersion === "V1"
+				? this.commands.EffectCtlV1
+				: this.commands.EffectCtlV2;
+
+		// Mirror OpenRGB SetAllColorsEffect(): write effect-color storage and apply.
+		let bytesWritten = 0;
+		while (bytesWritten < RGBData.length) {
+			const DataLength = Math.min(15, RGBData.length - bytesWritten);
+			const packet = RGBData.slice(bytesWritten, bytesWritten + DataLength);
+			this.Interface.WriteBlock(effectStart + bytesWritten, packet);
+			bytesWritten += DataLength;
+		}
+		this.Interface.WriteRegister(this.commands.ModeApplyAndSave, 0x01);
+		device.pause(100);
+
+		// Mirror OpenRGB Static mode: mode=1, speed=0, direction=0, then apply.
+		this.Interface.WriteRegister(this.commands.Mode, 0x01);
+		this.Interface.WriteRegister(this.commands.Speed, 0x00);
+		this.Interface.WriteRegister(this.commands.Direction, 0x00);
+		this.Interface.WriteRegister(this.commands.ModeApplyAndSave, 0x01);
+		device.pause(100);
+
+		// Select internal/effect mode and apply.
+		this.Interface.WriteRegister(this.commands.DirectMode, 0x00);
+		this.Interface.WriteRegister(this.commands.ModeApplyAndSave, 0x01);
+		device.pause(150);
+
+		// OpenRGB SaveMode(): ENE_REG_APPLY (0x80A0) <- 0xAA.
+		this.Interface.WriteRegister(this.commands.ModeApplyAndSave, 0xaa);
+		device.pause(500);
+
+		device.log(
+			`ENE persistent static save sent for ${hexColor}; restoring SignalRGB direct runtime mode.`
+		);
+
+		// Restore SignalRGB's normal direct runtime mode WITHOUT issuing another save.
+		this.Interface.WriteRegister(this.commands.DirectMode, 0x01);
+		this.Interface.WriteRegister(this.commands.ModeApplyAndSave, 0x01);
 	}
 
